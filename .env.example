# FJSTI Talaba Hamrohi - Muhit o'zgaruvchilari namunasi
# Ushbu faylni .env deb nusxalang va haqiqiy qiymatlarni kiriting.
# DIQQAT: .env faylini hech qachon GitHub yoki ommaviy joylarga yuklamang!

# Telegram Bot Token (@BotFather orqali olingan)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Neon PostgreSQL Connection URL
# Masalan: postgresql://username:password@ep-xyz-123.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Bot Adminlarining Telegram ID raqamlari (vergul bilan ajratilgan)
# Telegramda o'z ID raqamingizni @userinfobot orqali bilib olishingiz mumkin
ADMIN_TELEGRAM_IDS=123456789,987654321

# Dastur muhiti (development yoki production)
NODE_ENV=production

# Render Web Service sifatida ishlatilsa kerak bo'ladi (Background Worker uchun shart emas)
PORT=3000
